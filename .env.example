# Secrets for the judged rules. Nothing here is loaded automatically — the value must be in
# the environment of the process that starts the agent host (OpenCode, pi, or CI). See
# SECRETS.md for the whole contract.
#
# joggle reads TYPESAFE_API_KEY through Effect Config, so any launcher that populates the
# environment works:
#
#   doppler run -p joggle -c dev -- opencode     # or -- pi
#   op run -- opencode                           # 1Password
#   direnv allow                                 # .envrc, auto on cd
#   node --env-file=.env.local packages/joggle/src/main.ts
#
# A missing key is not a crash: judged rules step aside and the report says "not judged".
# Reviewed verdicts are committed under .joggle/answers/, so `joggle check --offline` (and
# `jig check`) replays them with no key at all. That is the path CI and fresh checkouts use.
#
# Copy this file to .env.local only if a launcher you use reads it; it is gitignored.
TYPESAFE_API_KEY=

# Optional. Points the System One client at a self-hosted or enterprise deployment when
# evidence must not leave the organisation's boundary. Defaults to https://api.typesafe.ai.
# TYPESAFE_BASE_URL=
