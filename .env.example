# Secrets for the workspace gates. Copy to .env.local (gitignored) or inject
# from a secret manager. Never commit a value.
#
# joggle's judged rules read this through Effect Config, so anything that sets
# the process environment works. This machine keeps the value in Doppler under
# project `joggle`, config `dev`; run the judged gates from the root with:
#
#   doppler run -p joggle -c dev -- pnpm jig check
#
# A missing key is not a crash: judged rules step aside and the report says
# "no model key reached the provider". Reviewed verdicts are committed under
# packages/joggle/.joggle/answers/, so `joggle check --offline` replays them and
# needs no key at all. The value is never written to the judgement cache.
TYPESAFE_API_KEY=

# Optional. Points the System One client at a self-hosted or enterprise
# deployment when evidence must not leave the organisation's boundary.
# Defaults to https://api.typesafe.ai.
# TYPESAFE_BASE_URL=
