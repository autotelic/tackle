{
  "name": "@autotelic/tackle",
  "version": "0.0.0",
  "private": true,
  "description": "One workspace for the conformance tools: plumb, joggle, cutlist, jig — and the protocol they agree on.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "herdr:test": "node --test herdr/factory/presence.test.mjs",
    "lint": "node scripts/lint.mjs",
    "lint:json": "node scripts/lint.mjs --format json",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lexicon:compat": "pnpm --filter @autotelic/protocol lexicon:compat",
    "check:catalog": "node scripts/check-catalog.mjs",
    "check:packages": "pnpm -r --if-present run check",
    "check": "pnpm format:check && pnpm typecheck && pnpm mailbox:verify && pnpm test && pnpm herdr:test && pnpm lexicon:compat && pnpm check:catalog && pnpm check:packages && pnpm build",
    "prepare": "effect-tsgo patch --typescript-package @typescript/native --typescript --oxlint",
    "cutlist": "node --conditions=development packages/cutlist/src/cli.ts",
    "jig": "node --conditions=development packages/jig-cli/src/cli.ts",
    "judged": "doppler run -p joggle -c dev -- pnpm jig check",
    "foreman": "node tools/foreman/src/main.ts",
    "changeset": "changeset",
    "version": "changeset version && oxfmt --write packages/*/CHANGELOG.md",
    "release": "node --conditions=development scripts/release.ts",
    "mailbox:verify": "for log in docs/threads/*/log.jsonl; do node --conditions=development packages/room/src/Mailbox/cli.ts verify --log \"$log\" --dir \"$(dirname \"$log\")\" || exit 1; done"
  },
  "devDependencies": {
    "@autotelic/cutlist": "workspace:*",
    "@autotelic/jig-cli": "workspace:*",
    "@autotelic/joggle": "workspace:*",
    "@autotelic/plumb": "workspace:*",
    "@changesets/cli": "^2.29.0",
    "@effect/platform-node": "catalog:",
    "@effect/tsgo": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "effect": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24.18.0"
  },
  "packageManager": "pnpm@12.3.4"
}
