{
  "name": "@autotelic/tackle",
  "version": "0.0.0",
  "private": true,
  "description": "One workspace for the conformance tools: plumb, joggle, cutlist, jig — and the protocol they agree on.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "lint": "oxlint --ignore-pattern 'examples/**' --ignore-pattern 'packages/plumb/**' --ignore-pattern 'packages/joggle/**' --ignore-pattern 'tools/**' packages/protocol packages/cutlist packages/jig-cli oxlint.config.ts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lexicon:compat": "pnpm --filter @autotelic/protocol lexicon:compat",
    "check:catalog": "node scripts/check-catalog.mjs",
    "check:packages": "pnpm -r --if-present run check",
    "check": "pnpm format:check && pnpm typecheck && pnpm test && pnpm lexicon:compat && pnpm check:catalog && pnpm check:packages && pnpm build",
    "prepare": "effect-tsgo patch --typescript-package @typescript/native --typescript --oxlint",
    "cutlist": "node --conditions=development packages/cutlist/src/cli.ts",
    "jig": "node --conditions=development packages/jig-cli/src/cli.ts",
    "judged": "doppler run -p joggle -c dev -- pnpm jig check",
    "foreman": "node tools/foreman/src/main.ts",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@autotelic/cutlist": "workspace:*",
    "@autotelic/joggle": "workspace:*",
    "@autotelic/plumb": "workspace:*",
    "@changesets/cli": "^2.29.0",
    "@effect/tsgo": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24.18.0"
  },
  "packageManager": "pnpm@12.3.4"
}
