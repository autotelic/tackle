{
  "compilerOptions": {
    "target": "es2024",
    "lib": [
      "es2024"
    ],
    "module": "preserve",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "noEmit": true,
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    // The workspace's own map, repeated because this package keeps a self-contained
    // compiler config (it does not extend tsconfig.base.json). Without it, a FRESH
    // checkout has no protocol/dist to resolve against, and typecheck only passed on a
    // machine where an earlier build had left one.
    "paths": {
      "@autotelic/protocol": ["../protocol/src/index.ts"],
      "@autotelic/protocol/*": ["../protocol/src/*"],
      // The stand-in is test-only, but its source is what the test exercises. Without this
      // map the package resolves to dist, and a fresh checkout has no dist to resolve.
      "@autotelic/standin": ["../standin/src/index.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": [
    "tests/fixtures"
  ]
}