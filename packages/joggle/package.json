{
  "name": "@autotelic/joggle",
  "version": "0.1.0",
  "type": "module",
  "description": "Cross-file patterns and idioms for TypeScript — the layer above the linter and the typechecker.",
  "license": "MIT",
  "homepage": "https://github.com/autotelic/tackle/tree/main/packages/joggle#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/autotelic/tackle.git",
    "directory": "packages/joggle"
  },
  "bugs": {
    "url": "https://github.com/autotelic/tackle/issues"
  },
  "keywords": [
    "typescript",
    "linter",
    "static-analysis",
    "cross-file",
    "oxc",
    "effect",
    "code-quality",
    "pi-package"
  ],
  "engines": {
    "node": ">=24.18.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "exports": {
    "./plugin": {
      "development": "./src/plugin.ts",
      "default": "./dist/plugin.js"
    },
    "./testing": {
      "development": "./src/testing.ts",
      "default": "./dist/testing.js"
    },
    "./presets/composition": {
      "development": "./src/presets/composition.ts",
      "default": "./dist/presets/composition.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "extensions",
    "JOGGLE.md"
  ],
  "bin": {
    "joggle": "./bin/joggle.js"
  },
  "scripts": {
    "joggle": "node --conditions=development src/main.ts",
    "joggle:elsewhere": "sh scripts/joggle-elsewhere.sh",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm check",
    "typecheck": "tsc --noEmit",
    "prepare": "effect-tsgo patch --typescript-package @typescript/native --typescript --oxlint",
    "test": "vitest run",
    "lint": "node scripts/lint-baseline.mjs",
    "lint:update": "node scripts/lint-baseline.mjs --update",
    "diagram:rules": "node scripts/diagram-rules.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm lint"
  },
  "dependencies": {
    "@effect/ai-typesafe": "catalog:",
    "@effect/platform-node": "catalog:",
    "effect": "catalog:",
    "oxc-parser": "catalog:"
  },
  "devDependencies": {
    "@autotelic/plumb": "workspace:*",
    "@effect/tsgo": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typebox": "1.3.34",
    "vitest": "catalog:"
  }
}
