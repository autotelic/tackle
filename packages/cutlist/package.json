{
  "name": "@autotelic/cutlist",
  "version": "0.0.0",
  "description": "The vocabulary: crawl a UI codebase into tokens, tiers, owners, and duplicate candidates; render the catalog, the lint manifest, and the menu (diagrams when asked).",
  "license": "MIT",
  "bin": {
    "cutlist": "./bin/cutlist.js"
  },
  "files": [
    "dist",
    "bin"
  ],
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./cli": {
      "development": "./src/cli.ts",
      "default": "./dist/cli.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "cutlist": "node --conditions=development src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@autotelic/protocol": "workspace:*",
    "@effect/platform-node": "catalog:",
    "effect": "catalog:",
    "oxc-parser": "catalog:",
    "pele": "catalog:"
  },
  "devDependencies": {
    "@effect/tsgo": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "fast-check": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24.18.0"
  }
}
