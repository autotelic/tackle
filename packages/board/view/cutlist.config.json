    "menu": "cutlist/MENU.md",
    "intent": "cutlist/intent",
    "patterns": "cutlist/PATTERNS.md",
    "patternsJson": "cutlist/patterns.json",
    "recipes": "cutlist/RECIPES.md",
    "recipesJson": "cutlist/recipes.json",
    "hooks": "cutlist/hooks.md",
    "tokens": "cutlist/tokens.md"
  }
}
