{
  "name": "@autotelic/board",
  "version": "0.0.0",
  "private": true,
  "description": "The board: the shop supervisor, queue status and the one-owner lock.",
  "license": "MIT",
  "bin": {
    "board": "./bin/board.js",
    "factory": "./bin/factory.js",
    "mailbox-server": "./bin/mailbox-server.js"
  },
  "files": [
    "dist",
    "bin"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./cli": {
      "development": "./src/cli.ts",
      "default": "./dist/cli.js"
    },
    "./*": "./src/*.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "board": "node --conditions=development src/cli.ts"
  },
  "dependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.87",
    "@alchemy.run/domain": "2.0.0-beta.87",
    "@autotelic/protocol": "workspace:*",
    "@autotelic/room": "workspace:*",
    "@hpke/core": "1.10.1",
    "@ipld/dag-cbor": "11.0.0",
    "alchemy": "2.0.0-beta.87",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/tsgo": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24.18.0"
  }
}
