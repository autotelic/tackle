{
  "name": "@autotelic/factory",
  "version": "0.0.0",
  "private": true,
  "description": "The software factory: adopt in-flight work as durable workstreams, then watch and wake them.",
  "license": "MIT",
  "bin": {
    "factory": "./bin/factory.js"
  },
  "files": [
    "dist",
    "bin"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./cli": {
      "development": "./src/cli.ts",
      "default": "./dist/cli.js"
    },
    "./*": "./src/*.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "factory": "node --conditions=development src/cli.ts"
  },
  "dependencies": {
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/tsgo": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24.18.0"
  }
}
