{
  "$schema": "https://autotelic.dev/tackle/protocol/jig.config.json",
  "engines": [
    {
      "id": "cutlist",
      "kind": "process",
      "command": "cutlist",
      "args": ["--cwd", "examples/self"]
    },
    {
      "id": "plumb",
      "kind": "oxlint-plugin",
      "command": "oxlint",
      "config": "oxlint.config.ts",
      "args": [
        "--ignore-pattern",
        "examples/**",
        "--ignore-pattern",
        "packages/plumb/**",
        "--ignore-pattern",
        "packages/joggle/**",
        "--ignore-pattern",
        "tools/**"
      ]
    },
    {
      "id": "plumb-plumb",
      "kind": "oxlint-plugin",
      "command": "oxlint",
      "config": "packages/plumb/oxlint.config.ts",
      "args": ["packages/plumb/src"]
    },
    {
      "id": "plumb-joggle",
      "kind": "oxlint-plugin",
      "command": "oxlint",
      "config": "packages/joggle/oxlint.config.ts",
      "args": ["packages/joggle/src"]
    },
    {
      "id": "joggle",
      "kind": "process",
      "command": "joggle",
      "config": "joggle.config.json",
      "args": ["--typecheck"]
    }
  ],
  "gate": { "mode": "all", "baseline": ".jig-baseline.json", "failOn": "any-new" },
  "report": { "format": "text", "maxWarnings": -1 },
  "agent": { "cookbook": "JIG.md" }
}
