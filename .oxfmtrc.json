{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "semi": false,
  "singleQuote": false,
  "trailingComma": "all",
  "arrowParens": "always",
  "endOfLine": "lf",
  "ignorePatterns": [
    "packages/plumb/**",
    "packages/joggle/**",
    "packages/joggle/tests/fixtures/**",
    "examples/*/tools/ui-catalog/**"
  ]
}
