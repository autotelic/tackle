node_modules
dist/
*.tsbuildinfo
.turbo/
.DS_Store
coverage/

# Local secrets — never commit these. joggle reads TYPESAFE_API_KEY through
# Effect Config, so the value may arrive from the shell, Doppler, or a
# gitignored .env.local; none of them may be committed. See .env.example.
.env
.env.*
!.env.example
*.pem
.secrets*

# joggle local caches (committed answers live in .joggle/answers, which IS tracked)
.joggle/run-cache/
.joggle/parsecache/
# The derived fact store: machine-local, never reviewed, never committed.
.joggle/cache/store.sqlite
.joggle/cache/store.sqlite-wal
.joggle/cache/store.sqlite-shm
# Evidence that this machine had a store, so a deleted database reads as rebuilt.
.joggle/cache/store.seen
.joggle/types.json
.joggle/declaration-types.json
# Machine-local dependency surface: `joggle surface build` regenerates it per checkout.
.joggle/surface.json

# The foreman's SQLite store is a cache of the same chain the journal records by hand.
# The journal is the committed checkpoint; the .sqlite is disposable.
tools/foreman/*.sqlite
tools/foreman/*.sqlite-journal

# pi's per-project caches. The install list itself (.pi/settings.json) IS committed —
# it is what makes this repo's pi sessions dogfood the jig extension (see AGENTS.md).
.pi/fabric/
.pi/git/
.pi/npm/
.pi/sessions/

# The goal ledger is the pool's local state, not the repository's.
.pi/goals/
.pi/.goals-pool-snapshot.json

# OpenCode may install local plugin dependencies under here; none are committed.
.opencode/node_modules/

# celld dev state for the room bundle
packages/room/.celld/

# The shop's local lock and queue state; the workstreams live in ~/.factory.
.room/

# The Herdr app writes its own API types beside a mod it checks; they follow the app
# version, not this repo. The mod in herdr/factory is the source.
herdr/factory/*.d.ts
